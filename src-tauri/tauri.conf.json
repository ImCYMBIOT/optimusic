  "identifier": "io.github.imcymbiot.optimusic",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgyQkEzRTYyNDc4QkYzQUUKUldTdTg0dEhZajY2Z3J2NlVYbkJ5SjliZGgrQWN5Y2FtR0s5SUR4Q3hTUFJBMVNlanR6ODFzM3IK",
