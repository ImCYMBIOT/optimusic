{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimusic",
  "version": "0.2.1",
  "identifier": "io.github.imcymbiot.optimusic",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "publisher": "Agnivesh",
    "copyright": "Copyright (c) 2026 Agnivesh. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/ImCYMBIOT/optimusic",
    "shortDescription": "Unofficial lightweight YouTube Music desktop client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"]
      }
    }
  }
}
